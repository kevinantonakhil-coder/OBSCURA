# Leave these blank for the isolated browser-local demo.
# When a Firebase project is ready, these are public web-app config values,
# not service-account secrets. Never add an Admin SDK key or private secret here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local emulator mode is opt-in and never enabled in a production build.
VITE_FIREBASE_USE_EMULATORS=false
